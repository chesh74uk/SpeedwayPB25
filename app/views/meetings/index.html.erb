<p id="notice"><%= notice %></p>
<div class="row ">
  <div class="col-md-12">
    <div class="page-header"><h3>Meetings</h3></div>
  </div>
</div>

<div class="row ">
  <%= turbo_frame_tag "add_new_meeting" do %>
    <div class="col-md-12">
      <%= button_to "Add meetings", new_meeting_path, method: :get, class: "btn btn-small btn-outline-dark" %>
    </div>
  <% end %>
</div>

<% @meetings.each do |meeting| %>
  <hr>
  <div class="row">
    <div class="col-md-12">
      <%= button_to meeting.date.strftime("%a %b %d"), method: :get, class: "btn btn-info btn-block" %>
    </div>
  </div>
  <div class="row">
    <div class="col-md-12">
      <div class="d-flex bd-highlight">
        <div class="p-2 flex-fill bd-highlight">
          <%= meeting.home_rider.nil? ?
                (link_to meeting.home_team, new_meeting_home_rider_path(meeting, @home_rider)) :
                (link_to meeting.home_team, edit_meeting_home_rider_path(meeting, meeting.home_rider))
          %>
          : <%= home_score(meeting) %>
            </div>
        <div class="p-2 flex-fill bd-highlight">
          <%= meeting.away_rider.nil? ?
                (link_to meeting.away_team, new_meeting_away_rider_path(meeting, @away_rider)) :
                (link_to meeting.away_team, edit_meeting_away_rider_path(meeting, meeting.away_rider))
          %>
          : <%= away_score(meeting) %>
        </div>
      </div>
    </div>
  </div>
  <div class="row">
    <div class="col-md-12">
      <div class="d-flex bd-highlight">
        <div class="p-2 flex-fill bd-highlight">
          <%= turbo_frame_tag "edit_meeting" do %>
            <%= button_to 'Edit', edit_meeting_path(meeting), class: 'btn btn-sm btn-outline-secondary', method: :get %>
          <% end %>
        </div>
        <div class="p-2 flex-fill bd-highlight">
          <%= button_to 'Delete', meeting, method: :delete, data: { turbo_confirm: 'Are you sure?' }, class: 'btn btn-sm btn-outline-secondary' %>
        </div>
      </div>
    </div>
  </div>
  <%= meeting.home_rider.nil? || meeting.away_rider.nil? ?
        ("Create team first") :
        ( button_to "Heats", new_meeting_heat_path(meeting), method: :get, class: "btn btn-sm btn-info btn-dark" ) %>
<% end %>

