<h3>Meeting stats: <%= @meeting.date.strftime("%a %b %d") %></h3>


<table class="table table-hover table-sm table-bordered">
  <thead class="thead-light">
  <tr>
    <th>#</th>
    <th><%= @meeting.home_team %></td>
    <th>Total</td>
    <th><%= @meeting.away_team %></td>
    <th>Total</td>
  </tr>
  </thead>
  <tbody>
  <tr>
    <th scope="row">1</th>
    <td><%= @meeting.home_rider.home_rider_1 %></td>
    <td><%= getHomeRiderStats(@meeting, @meeting.home_rider.home_rider_1) %></td>
    <td><%= @meeting.away_rider.away_rider_1 %></td>
    <td><%= getAwayRiderStats(@meeting, @meeting.away_rider.away_rider_1) %></td>
  </tr>

  <tr>
    <th scope="row">2</th>
    <td><%= @meeting.home_rider.home_rider_2 %></td>
    <td><%= getHomeRiderStats(@meeting, @meeting.home_rider.home_rider_2) %></td>
    <td><%= @meeting.away_rider.away_rider_2 %></td>
    <td><%= getAwayRiderStats(@meeting, @meeting.away_rider.away_rider_2) %></td>
  </tr>

  <tr>
    <th scope="row">3</th>
    <td><%= @meeting.home_rider.home_rider_3 %></td>
    <td><%= getHomeRiderStats(@meeting, @meeting.home_rider.home_rider_3) %></td>
    <td><%= @meeting.away_rider.away_rider_3 %></td>
    <td><%= getAwayRiderStats(@meeting, @meeting.away_rider.away_rider_3) %></td>
  </tr>

  <tr>
    <th scope="row">4</th>
    <td><%= @meeting.home_rider.home_rider_4 %></td>
    <td><%= getHomeRiderStats(@meeting, @meeting.home_rider.home_rider_4) %></td>
    <td><%= @meeting.away_rider.away_rider_4 %></td>
    <td><%= getAwayRiderStats(@meeting, @meeting.away_rider.away_rider_4) %></td>
  </tr>

  <tr>
    <th scope="row">5</th>
    <td><%= @meeting.home_rider.home_rider_5 %></td>
    <td><%= getHomeRiderStats(@meeting, @meeting.home_rider.home_rider_5) %></td>
    <td><%= @meeting.away_rider.away_rider_5 %></td>
    <td><%= getAwayRiderStats(@meeting, @meeting.away_rider.away_rider_5) %></td>
  </tr>

  <tr>
    <th scope="row">6</th>
    <td><%= @meeting.home_rider.home_rider_6 %></td>
    <td><%= getHomeRiderStats(@meeting, @meeting.home_rider.home_rider_6) %></td>
    <td><%= @meeting.away_rider.away_rider_6 %></td>
    <td><%= getAwayRiderStats(@meeting, @meeting.away_rider.away_rider_6) %></td>
  </tr>

  <tr>
    <th scope="row">7</th>
    <td><%= @meeting.home_rider.home_rider_7 %></td>
    <td><%= getHomeRiderStats(@meeting, @meeting.home_rider.home_rider_7) %></td>
    <td><%= @meeting.away_rider.away_rider_7 %></td>
    <td><%= getAwayRiderStats(@meeting, @meeting.away_rider.away_rider_7) %></td>
  </tr>

  </tbody>
</table>

<div class="row">
  <div class="col text-center">Gate statistics</div>
</div>
<hr>
<table class="table table-hover table-sm">
  <thead class="thead-light">
  <tr>
    <th>Gate</th>
    <th>Total</th>
  </tr>
  </thead>
  <tbody>
  <tr>
    <th scope="row">1</th>
    <td><%= gate_results(@meeting, 1) %></td>
  </tr>
  <tr>
    <th scope="row">2</th>
    <td><%= gate_results(@meeting, 2) %></td>
  </tr>
  <tr>
    <th scope="row">3</th>
    <td><%= gate_results(@meeting, 3) %></td>
  </tr>
  <tr>
    <th scope="row">4</th>
    <td><%= gate_results(@meeting, 4) %></td>
  </tr>
  </tbody>
</table>

<div class="row">
  <div class="col-sm-12">
    <%= button_to "Back", meetings_path(@meeting), method: :get, class: "btn btn-secondary btn-block" %>
  </div>
</div>
