<%= simple_form_for([@meeting, @home_rider]) do |f| %>
  <%= f.input :home_rider_1, input_html: {value: get_name(@meeting.home_team, 1)} %>
  <%= f.input :home_rider_2, input_html: {value: get_name(@meeting.home_team, 2)} %>
  <%= f.input :home_rider_3, input_html: {value: get_name(@meeting.home_team, 3)} %>
  <%= f.input :home_rider_4, input_html: {value: get_name(@meeting.home_team, 4)} %>
  <%= f.input :home_rider_5, input_html: {value: get_name(@meeting.home_team, 5)} %>
  <%= f.input :home_rider_6, input_html: {value: get_name(@meeting.home_team, 6)} %>
  <%= f.input :home_rider_7, input_html: {value: get_name(@meeting.home_team, 7)} %>
  <div class="row">
    <div class="col-md-12">
      <div class="d-flex bd-highlight">
        <div class="p-2 flex-fill bd-highlight">
          <%= f.button :submit, class: 'btn btn-sm btn-outline-success' %>
        </div>
        <div class="p-2 flex-fill bd-highlight">
          <%= link_to "Cancel", meetings_path, class: "btn btn-sm btn-outline-info" %>
        </div>
      </div>
    </div>
  </div>
<% end %>